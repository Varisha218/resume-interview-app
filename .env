# Copy this file to .env and fill in real values. app.py loads it automatically.

# Full connection string (takes priority over the PG* vars below).
DATABASE_URL=postgresql://interview_user:interview_pass@localhost:5432/interview_coach

# Used only if DATABASE_URL is not set:
PGHOST=localhost
PGPORT=5432
PGDATABASE=interview_coach
PGUSER=interview_user
PGPASSWORD=interview_pass

# Flask session signing key — set a real random value in production.
SECRET_KEY=dev-secret-change-me-in-production
